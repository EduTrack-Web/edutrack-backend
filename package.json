{
  "name": "edutrack-backend",
  "version": "1.0.0",
  "description": "Backend for Edutrack",
  "keywords": [
    "nodejs",
    "expressjs",
    "reactjs",
    "socketio"
  ],
  "homepage": "https://github.com/EduTrack-Web/edutrack-backend#readme",
  "bugs": {
    "url": "https://github.com/EduTrack-Web/edutrack-backend/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EduTrack-Web/edutrack-backend.git"
  },
  "license": "ISC",
  "author": "Phạm Thị Tuyết Minh, Cáp Thanh Nhàn",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test": "tsx --test tests/**/*.test.ts",
    "cleanup:notes": "tsx src/jobs/purge-expired-notes.ts",
    "migrate:google-avatars": "tsx src/jobs/migrate-google-avatars.ts",
    "holidays:validate": "tsx src/jobs/sync-official-holidays.ts --validate-only",
    "holidays:sync": "tsx src/jobs/sync-official-holidays.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "worker": "tsx src/worker.ts",
    "start:worker": "node dist/worker.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.2",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.3",
    "multer": "^2.5.0",
    "multer-storage-cloudinary": "^2.2.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.5.1",
    "tsc-alias": "^1.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true
  }
}
